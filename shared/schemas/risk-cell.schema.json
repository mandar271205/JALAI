{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiskCell",
  "type": "object",
  "required": [
    "h3_cell_id",
    "valid_time",
    "risk_level",
    "confidence",
    "model_version",
    "data_version"
  ],
  "properties": {
    "h3_cell_id": {
      "type": "string",
      "pattern": "^[89a-f0-9]{15}$"
    },
    "valid_time": {
      "type": "string",
      "format": "date-time"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH",
        "SEVERE"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "flood_depth_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "rainfall_rate_mm_h": {
      "type": [
        "number",
        "null"
      ]
    },
    "ward_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": "string"
    },
    "data_version": {
      "type": "string"
    }
  }
}