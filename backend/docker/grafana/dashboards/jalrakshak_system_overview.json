  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "API Request Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency (s)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency (s)"
        }
      ]
    },
    {
      "title": "API Throughput & Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "Total RPS"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx Errors / sec"
        },
        {
          "expr": "sum(http_active_requests)",
          "legendFormat": "Active In-Flight Requests"
        }
      ]
    },
    {
      "title": "Weather Telemetry Ingestion Lag (Freshness)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "weather_source_lag_seconds",
          "legendFormat": "{{source_id}} ({{source_type}})"
        }
      ]
    },
    {
      "title": "ML Model Inference Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ml_inference_duration_seconds_bucket[5m])) by (le, model_type))",
          "legendFormat": "{{model_type}} p95 latency (s)"
        }
      ]
    },
    {
      "title": "Celery Worker Queue Depth",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "celery_queue_depth",
          "legendFormat": "{{queue_name}}"
        }
      ]
    },
    {
      "title": "PostgreSQL Connection Pool Utilization",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "db_pool_connections",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "title": "Realtime & Alert Dissemination Delivery",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(notification_failures_total[5m]))",
          "legendFormat": "Notification Failures / min"
        },
        {
          "expr": "sum(rate(offline_sync_conflicts_total[5m]))",
          "legendFormat": "Sync Conflicts / min"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
