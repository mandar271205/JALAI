# ==============================================================================
# JALRAKSHAK AI — BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Team: NeuroBots | Problem Statement: SIH26071
# IMPORTANT: Commit .env.example with placeholders ONLY. Never commit actual secrets.
# Copy this file to .env before starting backend: cp .env.example .env
# ==============================================================================

# =========================
# APP / GENERAL
# =========================
APP_NAME="JalRakshak AI Backend"
APP_ENV=development
APP_SECRET=CHANGE_ME_SECRET_KEY
LOG_LEVEL=INFO
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://10.10.122.75:8081,http://10.10.122.75:3000

# =========================
# DATABASE / SUPABASE POSTGRESQL + POSTGIS
# =========================
# Connection Mode: "pooler" (Supabase Transaction Pooler, port 6543), "direct" (port 5432), or "local"
DB_CONNECTION_MODE=pooler
DB_STATEMENT_CACHE_SIZE=0

# Database URLs:
# 1. Supabase Transaction Pooler (Recommended for IPv4 / containers / high concurrency):
#    DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:<url_encoded_password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#    DATABASE_SYNC_URL=postgresql://postgres.<project_ref>:<url_encoded_password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# 2. Supabase Direct Connection (Requires IPv6 or Supabase IPv4 add-on):
#    DATABASE_URL=postgresql+asyncpg://postgres:<url_encoded_password>@db.<project_ref>.supabase.co:5432/postgres
#    DATABASE_SYNC_URL=postgresql://postgres:<url_encoded_password>@db.<project_ref>.supabase.co:5432/postgres
# 3. Local Docker Compose / Local PostgreSQL:
#    DATABASE_URL=postgresql+asyncpg://jalrakshak:jalrakshak@localhost:5432/jalrakshak
#    DATABASE_SYNC_URL=postgresql://jalrakshak:jalrakshak@localhost:5432/jalrakshak
DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:CHANGE_ME_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_SYNC_URL=postgresql://postgres.<project_ref>:CHANGE_ME_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Optional granular connection parameters
POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<project_ref>
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD

# =========================
# SUPABASE AUTH & API (OIDC / JWT)
# =========================
# Auth Mode: "mock" for local offline testing (bypasses remote Supabase verification)
#            "supabase" for verifying genuine Supabase ES256 / HS256 JWT tokens
AUTH_MODE=mock
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=CHANGE_ME_SUPABASE_JWT_SECRET

# =========================
# REDIS / CELERY
# =========================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =========================
# OBJECT STORAGE (MINIO / S3)
# =========================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=jalrakshak
MINIO_SECURE=false

# =========================
# ML INTERNAL SERVICE
# =========================
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=CHANGE_ME_ML_INTERNAL_TOKEN
ML_PROVIDER=stub

# =========================
# TILES (RASTER & VECTOR)
# =========================
TITILER_URL=http://localhost:8000
PGTILESERV_URL=http://localhost:7800

# =========================
# PUSH NOTIFICATIONS & ROUTING
# =========================
NOTIFICATION_PROVIDER=console
EXPO_PUSH_ACCESS_TOKEN=
ROUTING_PROVIDER=stub

# =========================
# OBSERVABILITY & MONITORING
# =========================
SENTRY_DSN=
OTEL_SERVICE_NAME=jalrakshak-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# =========================
# EVENT STREAMING (OPTIONAL)
# =========================
REDPANDA_BROKERS=
REDPANDA_USERNAME=
REDPANDA_PASSWORD=

# =========================
# DECISION SUPPORT & 3-MODEL AI ORCHESTRATION
# =========================
AI_INFERENCE_ENABLED=true
AI_PRIMARY_MODEL_SLOT=1
AI_SECONDARY_MODEL_SLOT=2
AI_VERIFIER_MODEL_SLOT=3

# Model 1: Groq Primary Generator
AI_LLM1_ENABLED=true
AI_LLM1_PROVIDER=groq
AI_LLM1_MODEL=openai/gpt-oss-120b
AI_LLM1_ROLE=primary_generator
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model 2: NVIDIA NIM Fast Failover
AI_LLM2_ENABLED=true
AI_LLM2_PROVIDER=nvidia
AI_LLM2_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_LLM2_ROLE=secondary_generator

# Model 3: NVIDIA NIM Heavy Verifier
AI_LLM3_ENABLED=true
AI_LLM3_PROVIDER=nvidia
AI_LLM3_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_LLM3_ROLE=heavy_verifier

# Shared NVIDIA Credentials
NVIDIA_API_KEY=CHANGE_ME_NVIDIA_API_KEY
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Verification Triggers & Thresholds
AI_VERIFIER_ENABLED=true
AI_VERIFY_HIGH_RISK=true
AI_VERIFY_SEVERE_RISK=true
AI_VERIFY_DISAGREEMENT=true
AI_VERIFY_LOW_SUPPORT=true
AI_VERIFIER_MIN_SUPPORT=0.65

# =========================
# VISION AI SUPPORT (GROQ MULTIMODAL EVIDENCE)
# =========================
AI_VISION_ENABLED=true
AI_VISION_PROVIDER=groq
AI_VISION_MODEL=qwen/qwen3.8-27b
AI_VISION_ROLE=citizen_visual_evidence
