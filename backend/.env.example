# ==============================================================================
# JALRAKSHAK AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Team: NeuroBots | Problem Statement: SIH26071
# IMPORTANT: Commit .env.example with placeholders ONLY. Never commit actual secrets.
# ==============================================================================

# =========================
# APP
# =========================
APP_ENV=development
APP_NAME=jalrakshak-backend
APP_SECRET=CHANGE_ME_SECRET_KEY
LOG_LEVEL=INFO
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =========================
# POSTGRES / POSTGIS
# =========================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jalrakshak
POSTGRES_USER=jalrakshak
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://jalrakshak:CHANGE_ME_DB_PASSWORD@postgres:5432/jalrakshak
DATABASE_SYNC_URL=postgresql://jalrakshak:CHANGE_ME_DB_PASSWORD@postgres:5432/jalrakshak

# =========================
# REDIS / CELERY
# =========================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# =========================
# OBJECT STORAGE (MINIO / S3)
# =========================
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=jalrakshak
MINIO_SECURE=false

# =========================
# AUTH (SUPABASE / OIDC)
# =========================
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_JWT_SECRET=CHANGE_ME_JWT_SECRET_32_BYTES_MIN
AUTH_MODE=mock

# =========================
# ML INTERNAL SERVICE
# =========================
ML_SERVICE_URL=http://ml-stub:8001
ML_SERVICE_TOKEN=CHANGE_ME_ML_INTERNAL_TOKEN
ML_PROVIDER=stub

# =========================
# TILES (RASTER & VECTOR)
# =========================
TITILER_URL=http://titiler:8000
PGTILESERV_URL=http://pg_tileserv:7800

# =========================
# PUSH NOTIFICATIONS & ROUTING
# =========================
NOTIFICATION_PROVIDER=console
EXPO_PUSH_ACCESS_TOKEN=
ROUTING_PROVIDER=stub

# =========================
# OBSERVABILITY & MONITORING
# =========================
SENTRY_DSN=
OTEL_SERVICE_NAME=jalrakshak-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# =========================
# EVENT STREAMING (OPTIONAL)
# =========================
REDPANDA_BROKERS=
REDPANDA_USERNAME=
REDPANDA_PASSWORD=

# =========================
# DECISION SUPPORT & 3-MODEL AI ORCHESTRATION
# =========================
AI_INFERENCE_ENABLED=true
AI_PRIMARY_MODEL_SLOT=1
AI_SECONDARY_MODEL_SLOT=2
AI_VERIFIER_MODEL_SLOT=3

# Model 1: Groq Primary Generator
AI_LLM1_ENABLED=true
AI_LLM1_PROVIDER=groq
AI_LLM1_MODEL=openai/gpt-oss-120b
AI_LLM1_ROLE=primary_generator
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model 2: NVIDIA NIM Fast Failover
AI_LLM2_ENABLED=true
AI_LLM2_PROVIDER=nvidia
AI_LLM2_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_LLM2_ROLE=secondary_generator

# Model 3: NVIDIA NIM Heavy Verifier
AI_LLM3_ENABLED=true
AI_LLM3_PROVIDER=nvidia
AI_LLM3_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_LLM3_ROLE=heavy_verifier

# Shared NVIDIA Credentials
NVIDIA_API_KEY=CHANGE_ME_NVIDIA_API_KEY
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Verification Triggers & Thresholds
AI_VERIFIER_ENABLED=true
AI_VERIFY_HIGH_RISK=true
AI_VERIFY_SEVERE_RISK=true
AI_VERIFY_DISAGREEMENT=true
AI_VERIFY_LOW_SUPPORT=true
AI_VERIFIER_MIN_SUPPORT=0.65

