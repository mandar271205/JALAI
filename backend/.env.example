# ==============================================================================
# JALAI / JalRakshak Backend Environment Configuration Template
# ==============================================================================

# Application Environment
APP_NAME="JalRakshak AI Backend"
APP_ENV=local
APP_SECRET=dev-secret-change-in-production
LOG_LEVEL=INFO
DEBUG=true

# Authentication Mode ("mock" for local dev, "supabase" for production JWT validation)
AUTH_MODE=mock
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://jalrakshak:jalrakshak@localhost:5432/jalrakshak
DATABASE_SYNC_URL=postgresql://jalrakshak:jalrakshak@localhost:5432/jalrakshak
POSTGRES_DB=jalrakshak
POSTGRES_USER=jalrakshak
POSTGRES_PASSWORD=jalrakshak

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=jalrakshak
MINIO_SECURE=false

# ML & Routing Providers ("stub" for fast offline/local dev, "service" for microservice)
ML_PROVIDER=stub
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=dev-ml-token
ROUTING_PROVIDER=stub
NOTIFICATION_PROVIDER=console

# Observability (Optional)
PROMETHEUS_ENABLED=true
OTEL_SERVICE_NAME=jalrakshak-backend
# SENTRY_DSN=
