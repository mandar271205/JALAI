# ==============================================================================
# JALAI Web Command Center Environment Configuration (.env.example)
# Copy this file to .env.local before running: npm run dev
# ==============================================================================

# Backend API Endpoint
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth Configuration
# Required for production Supabase auth. In mock mode, defaults are permitted.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Mock Auth Mode: "true" to allow test login credentials (mock admin/operator/analyst)
NEXT_PUBLIC_ENABLE_MOCK_AUTH=true
