{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditEvent",
  "type": "object",
  "required": [
    "log_id",
    "timestamp",
    "actor_id",
    "action",
    "target_entity",
    "target_id"
  ],
  "properties": {
    "log_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "target_entity": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "details": {
      "type": "object"
    }
  }
}