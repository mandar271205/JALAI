{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Alert",
  "type": "object",
  "required": [
    "alert_id",
    "headline",
    "severity",
    "urgency",
    "certainty",
    "status",
    "sent_at",
    "area_description"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "format": "uuid"
    },
    "headline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instruction": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Extreme",
        "Severe",
        "Moderate",
        "Minor",
        "Unknown"
      ]
    },
    "urgency": {
      "type": "string",
      "enum": [
        "Immediate",
        "Expected",
        "Future",
        "Past",
        "Unknown"
      ]
    },
    "certainty": {
      "type": "string",
      "enum": [
        "Observed",
        "Likely",
        "Possible",
        "Unlikely",
        "Unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_APPROVAL",
        "PUBLISHED",
        "CANCELLED"
      ]
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "area_description": {
      "type": "string"
    },
    "cap_xml": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}