{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FieldReport",
  "type": "object",
  "required": [
    "report_id",
    "submitted_at",
    "location",
    "verification_status"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "citizen_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        }
      }
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "AI_VERIFIED",
        "HUMAN_VERIFIED",
        "REJECTED"
      ]
    },
    "ai_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "estimated_water_depth_cm": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}