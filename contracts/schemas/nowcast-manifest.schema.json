{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NowcastManifest",
  "type": "object",
  "required": [
    "manifest_id",
    "generated_at",
    "valid_from",
    "valid_to",
    "lead_time_minutes",
    "cog_url",
    "model_version",
    "data_version"
  ],
  "properties": {
    "manifest_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    },
    "lead_time_minutes": {
      "type": "integer"
    },
    "cog_url": {
      "type": "string",
      "format": "uri"
    },
    "bounds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "model_version": {
      "type": "string"
    },
    "data_version": {
      "type": "string"
    }
  }
}