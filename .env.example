# ==============================================================================
# JALRAKSHAK AI — UNIFIED ROOT ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# Application Environment
ENV=development
DEBUG=true

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI Gateway)
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://jalrakshak:jalrakshak@localhost:5432/jalrakshak
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Inter-Service Integration
ML_SERVICE_URL=http://localhost:8001
ML_AUTH_TOKEN=dev-ml-token
ML_TIMEOUT_SECONDS=10.0
ML_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# ML Serving Service Configuration
# ------------------------------------------------------------------------------
ML_PORT=8001
ML_INTERNAL_API_KEY=dev-ml-token

# ------------------------------------------------------------------------------
# 3-Model AI Decision Support Configuration (Groq + NVIDIA NIM)
# ------------------------------------------------------------------------------
AI_INFERENCE_ENABLED=true
AI_PRIMARY_MODEL_SLOT=1
AI_SECONDARY_MODEL_SLOT=2
AI_VERIFIER_MODEL_SLOT=3

# MODEL 1 — Groq Primary Generator
AI_LLM1_ENABLED=true
AI_LLM1_PROVIDER=groq
AI_LLM1_MODEL=openai/gpt-oss-120b
AI_LLM1_ROLE=primary_generator
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1

# MODEL 2 — NVIDIA NIM Fast Secondary Failover
AI_LLM2_ENABLED=true
AI_LLM2_PROVIDER=nvidia
AI_LLM2_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_LLM2_ROLE=secondary_generator

# MODEL 3 — NVIDIA NIM Heavy Verifier / Judge
AI_LLM3_ENABLED=true
AI_LLM3_PROVIDER=nvidia
AI_LLM3_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_LLM3_ROLE=heavy_verifier

# Shared NVIDIA NIM Credentials
NVIDIA_API_KEY=CHANGE_ME_NVIDIA_API_KEY
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Arbitration & Verification Policy
AI_VERIFIER_ENABLED=true
AI_VERIFY_HIGH_RISK=true
AI_VERIFY_SEVERE_RISK=true
AI_VERIFY_DISAGREEMENT=true
AI_VERIFY_LOW_SUPPORT=true
AI_VERIFIER_MIN_SUPPORT=0.65
